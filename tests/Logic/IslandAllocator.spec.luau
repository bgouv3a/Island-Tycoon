--!strict
-- selene: allow(undefined_variable)
return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local IslandAllocator = require(ReplicatedStorage.Shared.Logic.IslandAllocator)

	describe("IslandAllocator", function()
		it("rejeita quantidade de slots inválida", function()
			expect(pcall(IslandAllocator.new, 0)).to.equal(false)
			expect(pcall(IslandAllocator.new, 2.5)).to.equal(false)
		end)

		it("dois jogadores recebem slots diferentes", function()
			local a = IslandAllocator.new(3)
			local s1 = IslandAllocator.Assign(a, 100)
			local s2 = IslandAllocator.Assign(a, 200)
			expect(s1).to.be.ok()
			expect(s2).to.be.ok()
			expect(s1 ~= s2).to.equal(true)
		end)

		it("atribuir de novo a mesma chave devolve o mesmo slot", function()
			local a = IslandAllocator.new(3)
			local first = IslandAllocator.Assign(a, 100)
			expect(IslandAllocator.Assign(a, 100)).to.equal(first)
			expect(IslandAllocator.Assign(a, 100)).to.equal(first)
		end)

		it("devolve nil quando não há slot livre", function()
			local a = IslandAllocator.new(2)
			IslandAllocator.Assign(a, 1)
			IslandAllocator.Assign(a, 2)
			expect(IslandAllocator.Assign(a, 3)).to.equal(nil)
		end)

		it("libera o slot ao sair e o reutiliza", function()
			local a = IslandAllocator.new(1)
			local slot = IslandAllocator.Assign(a, 1)
			expect(IslandAllocator.Release(a, 1)).to.equal(slot)
			expect(IslandAllocator.GetSlot(a, 1)).to.equal(nil)
			expect(IslandAllocator.Assign(a, 2)).to.equal(slot)
		end)

		it("liberar uma chave sem slot não altera nada", function()
			local a = IslandAllocator.new(2)
			IslandAllocator.Assign(a, 1)
			expect(IslandAllocator.Release(a, 99)).to.equal(nil)
			expect(IslandAllocator.GetSlot(a, 1)).to.be.ok()
		end)
	end)
end
